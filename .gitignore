# Sensitive configuration - DO NOT COMMIT
demand_backend/src/main/resources/application*.yml
demand_backend/src/main/resources/application*.properties
demand_backend/target/
demand_frontend/.env
demand_frontend/.env.production
demand_frontend/.env.*.local

# Build outputs
demand_backend/target/
demand_frontend/dist/
demand_frontend/node_modules/
demand_h5/dist/
demand_h5/node_modules/

# 构建前给旧产物改名的备份（vite 的 emptyOutDir 会被沙箱批量删除守卫拦下，故先改名再 build）
dist-bak-*/
dist-bad-*/

# Test artifacts (临时调试截图、E2E 报告等，不入库)
data/
contracts/openapi/
probe-*.png
shots/
demand_frontend/test-report.*
demand_frontend/console-audit-result.json
demand_frontend/e2e/.auth/
*.bak

# Auto-generated type declarations (unplugin-auto-import / unplugin-vue-components)
demand_frontend/auto-imports.d.ts
demand_frontend/components.d.ts

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Windows nul 空设备文件（Git Bash 下执行 .bat 会意外生成）
nul

# Temp
*.tmp
*.temp
Temp/

# Local oh-my-codex runtime state
.omx/

# Claude Code local state
.claude/

# Codex temp
.codex-tmp/

# Codex deps (npm packages downloaded by codex)
.codex-deps/

# All codex runtime directories
.codex-*/

# Test reports
demand_frontend/playwright-report/
demand_frontend/test-results/

# AGENTS.md (local agent config)
AGENTS.md

# Local Claude Code quick-start script (uses dangerously-skip-permissions, do not ship)
start-claude.bat

# Local agent runtime state (workbuddy memory, do not ship)
.workbuddy/
.workbuddy-ai/

# 编辑器 / 本机工具配置
.zcodeignore
.zcode/

# Local import artifacts (env-specific creds/logic, do not ship)
req-import/

# scripts/: 通用启动基础设施入库（compose / ps1），仅排除本地 env 与临时产物
scripts/.env
scripts/.env.*.local
scripts/out/

# AI 智能助手（CodeBuddy Agent SDK 独立子项目，自带 .gitignore，这里再兜底一层）
demand_assistant/node_modules/
demand_assistant/dist/
demand_assistant/data/
demand_assistant/.env
