<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.demand.system.module.rbac.mapper.RoleDataScopeOrgMapper">

    <!-- 根据角色ID列表查询所有关联的组织ID -->
    <select id="selectOrgIdsByRoleIds" resultType="java.lang.Long">
        SELECT DISTINCT org_id
        FROM role_data_scope_orgs
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <!-- 删除角色下所有数据权限组织 -->
    <delete id="deleteByRoleId">
        DELETE FROM role_data_scope_orgs WHERE role_id = #{roleId}
    </delete>

</mapper>
