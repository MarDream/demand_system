# Compose 环境变量模板
# 使用方法: 复制此文件为 scripts/.env 并填入实际值
# scripts/.env 被 .gitignore 排除，不会入库
# 未提供 .env 时，Compose 会使用 docker-compose.yml 中 ${VAR:-default} 的默认值

# MySQL（默认 admin123 / 数据库 demand_system）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=demand_system

# RabbitMQ（默认 admin / admin）
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO（默认 admin / admin123456）
MINIO_USER=
MINIO_PASSWORD=
